SLIPGATE_LISTEN_ADDR=:8080
SLIPGATE_SUPERVISE=true
SLIPGATE_ALLOW_DEGRADED=false
SLIPGATE_CORE_IPC=127.0.0.1:19081
SLIPGATE_BFF_ADDR=127.0.0.1:19082

# mode: release (production pinned) | dev (auto-sync & hot-reload from GitHub repo)
SLIPGATE_MODE=release
SLIPGATE_DEV_SYNC_MODE=auto
SLIPGATE_DEV_SYNC_INTERVAL_SEC=60
SLIPGATE_UPDATE_REPO=dreamforSh/Slipgate
SLIPGATE_UPDATE_BRANCH=main
# Optional for higher GitHub API rate limits:
# SLIPGATE_GITHUB_TOKEN=

SLIPGATE_CLASH_MODE=embedded
SLIPGATE_CLASH_DATA_DIR=/var/run/slipgate/clash
SLIPGATE_CLASH_PORT_MIN=20000
SLIPGATE_CLASH_PORT_MAX=24999
SLIPGATE_MAX_ACCOUNTS_PER_EXIT_IP=1
SLIPGATE_CLASH_PROBE_URL=https://www.gstatic.com/generate_204
SLIPGATE_CLASH_IP_ECHO_URL=https://api.ipify.org?format=json
SLIPGATE_CLASH_PROBE_INTERVAL_SEC=300

SLIPGATE_JWT_SECRET=change-me-32-byte-jwt-secret
SLIPGATE_VAULT_SECRET=change-me-32-byte-vault-secret

POSTGRES_DB=slipgate
POSTGRES_USER=slipgate
POSTGRES_PASSWORD=change-me-secure-password
DATABASE_URL=postgres://slipgate:change-me-secure-password@postgres:5432/slipgate
REDIS_URL=redis://redis:6379
