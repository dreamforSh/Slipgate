SLIPGATE_LISTEN_ADDR=:8080
SLIPGATE_SUPERVISE=true
SLIPGATE_ALLOW_DEGRADED=false
SLIPGATE_CORE_IPC=127.0.0.1:19081
SLIPGATE_BFF_ADDR=127.0.0.1:19082

SLIPGATE_CLASH_PORT_MIN=20000
SLIPGATE_CLASH_PORT_MAX=24999
SLIPGATE_MAX_ACCOUNTS_PER_EXIT_IP=1

POSTGRES_DB=slipgate
POSTGRES_USER=slipgate
POSTGRES_PASSWORD=change-me-secure-password
DATABASE_URL=postgres://slipgate:change-me-secure-password@postgres:5432/slipgate
REDIS_URL=redis://redis:6379
